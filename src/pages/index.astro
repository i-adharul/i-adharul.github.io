---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroup from '../components/SkillGroup.astro';
import CourseRow from '../components/CourseRow.astro';
import { SITE } from '../site';
import { hero, selectedWork, skills, courseWork, contact } from '../data/home';
const wrap = 'mx-auto max-w-page px-4 md:px-8 lg:px-12';
---
<Base title="Adharul Imron — Data Analyst" description={`${hero.subtitle}. SQL, Python, BigQuery, Tableau and Metabase case studies.`}>
  <!-- Hero -->
  <section class={`${wrap} py-14 md:py-24`}>
    <div class="grid items-center gap-10 md:grid-cols-[1fr_17rem] lg:grid-cols-[1fr_20rem] lg:gap-16">
      <div>
        <p class="t-caption uppercase tracking-wider text-accent">{hero.tagline}</p>
        <h1 class="t-display mt-4">{hero.title}</h1>
        <p class="t-body-lg mt-4 font-medium">{hero.subtitle}</p>
        <div class="mt-6 max-w-prose space-y-4 text-muted">
          {hero.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={SITE.linkedin} external>Let's Connect</Button>
          <Button href="#work" variant="ghost">See my work <Icon name="arrow-right" class="h-4 w-4" /></Button>
        </div>
      </div>
      <Image src={hero.portrait} alt={hero.portraitAlt} width={800} height={1000} widths={[400, 800]}
        sizes="(min-width: 1024px) 320px, (min-width: 768px) 272px, 60vw" format="webp" fit="cover" position="top"
        class="aspect-[4/5] w-3/5 max-w-xs rounded-card border border-line object-cover md:w-full" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <!-- Selected Work -->
  <section id="work" class={`${wrap} border-t border-line py-14 md:py-20`}>
    <h2 class="t-headline-lg">Selected Work</h2>
    <div class="mt-8 space-y-6">
      {selectedWork.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class={`${wrap} border-t border-line py-14 md:py-20`}>
    <h2 class="t-headline-lg">Skills</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {skills.map((s) => <SkillGroup {...s} />)}
    </div>
  </section>

  <!-- Course work (secondary, collapsed) -->
  <section id="more-work" class={`${wrap} border-t border-line py-14 md:py-20`}>
    <details class="group rounded-card border border-line bg-surface">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-card p-5 md:p-6 [&::-webkit-details-marker]:hidden">
        <span>
          <span class="t-headline-md block">Course work &amp; more</span>
          <span class="t-body-sm text-muted">{courseWork.length} more projects</span>
        </span>
        <Icon name="arrow-right" class="h-5 w-5 shrink-0 rotate-90 text-muted transition-transform group-open:-rotate-90" />
      </summary>
      <ul class="divide-y divide-line border-t border-line px-5 md:px-6">
        {courseWork.map((item) => <CourseRow item={item} />)}
      </ul>
    </details>
  </section>

  <!-- Contact -->
  <section id="contact" class={`${wrap} border-t border-line py-14 md:py-20`}>
    <h2 class="t-headline-lg">{contact.heading}</h2>
    <p class="mt-4 max-w-prose text-muted">{contact.text}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={`mailto:${SITE.email}`}><Icon name="mail" class="h-4 w-4" /> {SITE.email}</Button>
      <Button href={SITE.linkedin} variant="ghost" external><Icon name="linkedin" class="h-4 w-4" /> LinkedIn</Button>
      <Button href={SITE.github} variant="ghost" external><Icon name="github" class="h-4 w-4" /> GitHub</Button>
    </div>
  </section>
</Base>
