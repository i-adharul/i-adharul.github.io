---
import { SITE } from '../site';
const links = [
  { label: 'Email', href: `mailto:${SITE.email}` },
  { label: 'GitHub', href: SITE.github },
  { label: 'LinkedIn', href: SITE.linkedin },
];
---
<footer class="border-t border-line">
  <div class="mx-auto flex max-w-page flex-col gap-3 px-4 py-8 text-muted sm:flex-row sm:items-center sm:justify-between md:px-8 lg:px-12">
    <p class="t-caption">© {new Date().getFullYear()} {SITE.name}</p>
    <ul class="flex gap-5">
      {links.map((l) => (
        <li><a href={l.href} class="t-caption hover:text-accent"{...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</footer>
