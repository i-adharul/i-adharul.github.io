---
import { Image } from 'astro:assets';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import type { Project } from '../lib/projects';
interface Props { project: Project; index: number; eager?: boolean }
const { project: p, index, eager = false } = Astro.props;
---
<article class="group relative grid gap-6 rounded-card border border-line bg-surface p-5 transition hover:-translate-y-0.5 hover:border-line-strong md:grid-cols-2 md:gap-8 md:p-8 shadow-[0_1px_3px_0_rgb(15_23_42/0.04),0_1px_2px_-1px_rgb(15_23_42/0.04)]">
  <div class="flex flex-col">
    <p class="t-caption uppercase tracking-wider text-accent">Case study {String(index + 1).padStart(2, '0')}</p>
    <h3 class="t-headline-md mt-2">
      <a href={p.href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-offset-4">{p.title}</a>
    </h3>
    <p class="mt-3 text-muted">{p.summary}</p>
    {p.finding && (
      <div class="mt-5 rounded-lg border border-line bg-figure p-4">
        <p class="t-caption uppercase tracking-wider text-muted">Key finding</p>
        <p class="mt-1 font-semibold tabular">{p.finding}</p>
      </div>
    )}
    <ul class="mt-5 flex flex-wrap gap-2">{p.chips.map((c) => <li><Chip>{c}</Chip></li>)}</ul>
    <p class="mt-6 inline-flex items-center gap-1.5 t-body-sm font-semibold text-accent" aria-hidden="true">
      Read case study <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </p>
  </div>
  <div class="overflow-hidden rounded-lg border border-line bg-figure md:self-start">
    {p.image && <Image src={p.image} alt={p.alt} width={800} widths={[400, 800]} sizes="(min-width: 768px) 460px, 90vw"
      format="webp" class="h-auto w-full" loading={eager ? 'eager' : 'lazy'} decoding="async" />}
  </div>
</article>
