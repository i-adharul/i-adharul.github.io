---
interface Props { headings: { depth: number; slug: string; text: string }[] }
const items = Astro.props.headings.filter((h) => h.depth === 2);
---
{items.length > 0 && (
  <nav aria-label="On this page">
    <p class="t-caption font-semibold uppercase tracking-wider text-muted">On this page</p>
    <ol class="mt-3 space-y-2 border-l border-line">
      {items.map((h, i) => (
        <li><a href={`#${h.slug}`} class="-ml-px block border-l border-transparent py-0.5 pl-4 t-body-sm text-muted hover:border-accent hover:text-accent">
          <span class="tabular">{String(i + 1).padStart(2, '0')}.</span> {h.text}</a></li>
      ))}
    </ol>
  </nav>
)}
