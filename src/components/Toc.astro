---
interface Props { headings: { depth: number; slug: string; text: string }[]; depth?: 2 | 3 }
const { headings, depth = 2 } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || (depth === 3 && h.depth === 3));
---
{items.length > 0 && (
  <nav aria-label="On this page">
    <p class="t-caption font-semibold uppercase tracking-wider text-muted">On this page</p>
    <ol class="mt-3 space-y-1.5 border-l border-line">
      {items.map((h) => (
        <li>
          <a href={`#${h.slug}`} class:list={['-ml-px block border-l border-transparent py-0.5 t-body-sm hover:border-accent hover:text-accent',
            h.depth === 2 ? 'pl-4 text-muted' : 'pl-8 text-muted text-[0.8125rem]']}>
            {h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
