---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
interface Props { item: Project }
const { item } = Astro.props;
---
<li class="group relative flex gap-4 py-5 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-accent sm:gap-6">
  <div class="h-20 w-28 shrink-0 overflow-hidden rounded-lg border border-line bg-figure sm:h-24 sm:w-36">
    {item.image
      ? <Image src={item.image} alt={item.alt} width={288} height={192} format="webp" fit="cover" position="top"
          class="h-full w-full object-cover" loading="lazy" decoding="async" />
      : <div class="flex h-full flex-col justify-between bg-canvas p-3">
          <span class="t-caption uppercase tracking-wider text-muted">{item.typeCard?.label}</span>
          <span class="t-body-sm font-semibold leading-tight">{item.typeCard?.text}</span>
        </div>}
  </div>
  <div class="min-w-0">
    <h3 class="t-headline-sm"><a href={item.href} class="after:absolute after:inset-0 after:content-[''] group-hover:text-accent">{item.title}</a></h3>
    <p class="mt-1 t-body-sm text-muted">{item.summary}</p>
  </div>
</li>
