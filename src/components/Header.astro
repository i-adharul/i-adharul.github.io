---
import { SITE, NAV } from '../site';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="sticky top-0 z-40 border-b border-line bg-canvas/80 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-page items-center justify-between px-4 md:px-8 lg:px-12">
    <a href="/" class="t-headline-sm">
      {SITE.name}<span class="hidden font-normal text-muted sm:inline"> — {SITE.title}</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-4 sm:gap-6">
      <ul class="flex items-center gap-4 sm:gap-6">
        {NAV.map((l) => (
          <li><a href={l.href} class="t-body-sm font-medium text-muted hover:text-accent">{l.label}</a></li>
        ))}
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>
