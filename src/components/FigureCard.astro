---
// Chart/screenshot frame: inset background + caption bar. Full-width inside the page.
interface Props { caption: string; pending?: boolean }
const { caption, pending = false } = Astro.props;
---
<figure class="my-8 overflow-hidden rounded-card border border-line bg-surface">
  <div class="bg-figure p-4 md:p-6">
    {pending
      ? <p class="py-10 text-center t-body-sm text-ink">Chart pending — TODO(owner): supply original image</p>
      : <slot />}
  </div>
  <figcaption class="border-t border-line px-4 py-3 t-caption text-muted">{caption}</figcaption>
</figure>
