---
import { Image } from 'astro:assets';
import FigureCard from '../FigureCard.astro';
interface Props { src: ImageMetadata; alt: string; caption: string; priority?: boolean }
const { src, alt, caption, priority = false } = Astro.props;
---
<div class="not-prose">
  <FigureCard caption={caption}>
    <!-- White mat keeps light-background screenshots from glaring in dark mode. -->
    <div class="overflow-hidden rounded-md bg-white">
      <Image src={src} alt={alt} widths={[640, 1100, 1500]} sizes="(min-width: 1024px) 720px, calc(100vw - 4rem)"
        format="webp" class="h-auto w-full" loading={priority ? 'eager' : 'lazy'} decoding="async" />
    </div>
  </FigureCard>
</div>
