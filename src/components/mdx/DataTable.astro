---
// Accessible, horizontally scrollable table. Generic: reuse for any comparison matrix.
interface Props { caption: string; columns: string[]; rows: string[][]; note?: string }
const { caption, columns, rows, note } = Astro.props;
---
<div class="not-prose my-8 rounded-card border border-line bg-surface">
  <div class="overflow-x-auto rounded-card" tabindex="0" role="region" aria-label={caption}>
    <table class="w-full min-w-[48rem] border-separate border-spacing-0 text-left t-body-sm tabular">
      <caption class="border-b border-line px-4 py-3 text-left t-caption uppercase tracking-wider text-muted">{caption}</caption>
      <thead>
        <tr>
          {columns.map((c) => <th scope="col" class="border-b border-line px-4 py-3 t-caption font-semibold uppercase tracking-wider text-muted">{c}</th>)}
        </tr>
      </thead>
      <tbody class="[&>tr:last-child>*]:border-b-0">
        {rows.map((r) => (
          <tr>
            {r.map((cell, i) => i === 0
              ? <th scope="row" class="border-b border-line px-4 py-3 font-semibold">{cell}</th>
              : <td class="border-b border-line px-4 py-3 align-top">{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="border-t border-line px-4 py-3 t-caption text-muted">{note}</p>}
</div>
