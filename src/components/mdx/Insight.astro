---
// Numbered insight as in the original page ("1. Title"), then body (markdown + Figure) from the slot.
interface Props { n: number; title: string }
const { n, title } = Astro.props;
---
<section id={`insight-${n}`} class="mt-12 scroll-mt-20" aria-labelledby={`insight-${n}-title`}>
  <h3 id={`insight-${n}-title`} class="mt-0 t-headline-sm"><span class="tabular text-accent">{n}.</span> <span>{title}</span></h3>
  <div class="mt-3"><slot /></div>
</section>
